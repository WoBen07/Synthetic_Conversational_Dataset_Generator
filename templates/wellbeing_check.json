{
  "messages": [
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_patient_appointment",
        "arguments": {
          "patient_id": "{{patient.patient_id}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_patient_appointment",
      "content": {
        "patient_id": "{{patient.patient_id}}",
        "name": "{{patient.full_name}}",
        "appointment": {
          "day": "{{appointment.day}}",
          "type": "{{appointment.appointment_type}}",
          "location": "{{appointment.location}}"
        }
      }
    },
    { "role": "assistant", "content": "{{reminder_and_checkin}}" },
    { "role": "user", "content": "{{patient_wellbeing_status}}" },
    { "role": "assistant", "content": "{{wellbeing_acknowledgment}}" },
    { "role": "user", "content": "{{unscoped_question}}" },
    { "role": "assistant", "content": "{{honest_unknown_response}}" },
    { "role": "user", "content": "{{scoped_question}}" },
    { "role": "assistant", "content": "{{direct_answer_response}}" },
    { "role": "assistant", "content": "{{closing}}" }
  ]
}
{
  "messages": [
    { "role": "user", "content": "{{task_request}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}",
          "{{alternative_patient}}"
        ]
      }
    },
    { "role": "assistant", "content": "{{clarify_request}}" },
    { "role": "user", "content": "{{clarification_response}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "remind_patient",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "message": "{{reminder_message}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "remind_patient",
      "content": {
        "status": "failed"
      }
    },
    { "role": "assistant", "content": "{{failure_acknowledgment}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "room_number": "{{patient.room_number}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "remind_patient",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "message": "{{reminder_message}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "remind_patient",
      "content": {
        "status": "success"
      }
    },
    { "role": "assistant", "content": "{{task_confirmation}}" }
  ]
}

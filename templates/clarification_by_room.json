{
  "messages": [
    {
      "role": "user",
      "content": "{{user_request}}"
    },
    {
      "role": "assistant",
      "content": "{{clarification_request}}"
    },
    {
      "role": "user",
      "content": "{{user_clarification}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "room_number": "{{patient.room_number}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    {
      "role": "assistant",
      "content": "{{acknowledgement}}"
    }
  ]
}
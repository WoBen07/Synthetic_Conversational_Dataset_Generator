{
  "messages": [
    {
      "role": "user",
      "content": "{{reminder_request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}",
          "{{alternative_patient}}"
        ]
      }
    },
    {
        "role": "assistant",
        "content": "{{additional_information_request}}"
    },
    {
        "role": "user",
        "content": "{{unable_to_give_information_phrase}}"
    },
    {
        "role": "assistant",
        "content": "{{unable_to_assist_phrase}}"
    }
  ]
}

{
  "messages": [
    {
      "role": "user",
      "content": "{{escort_request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_patient_appointment",
        "arguments": {
          "patient_id": "{{patient.patient_id}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_patient_appointment",
      "content": {
        "patient_id": "{{patient.patient_id}}",
        "name": "{{patient.full_name}}",
        "appointment": {
          "day": "{{appointment.day}}",
          "type": "{{appointment.appointment_type}}",
          "location": "{{appointment.location}}"
        }
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "navigate_to",
        "arguments": {
          "room": "{{appointment.location}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "navigate_to",
      "content": {
        "status": "arrived",
        "location": "{{appointment.location}}"
      }
    },
    {
      "role": "assistant",
      "content": "{{escort_confirmation}}"
    }
  ]
}

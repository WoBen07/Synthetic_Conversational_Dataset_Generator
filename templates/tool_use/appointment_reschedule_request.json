{
  "messages": [
    {
      "role": "user",
      "content": "{{cannot_attend_request}}"
    },
    {
      "role": "assistant",
      "content": "{{name_request}}"
    },
    {
      "role": "user",
      "content": "{{name_response}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_patient_appointment",
        "arguments": {
          "patient_id": "{{patient.patient_id}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_patient_appointment",
      "content": {
        "patient_id": "{{patient.patient_id}}",
        "name": "{{patient.full_name}}",
        "appointment": {
          "day": "{{appointment.day}}",
          "type": "{{appointment.appointment_type}}",
          "location": "{{appointment.location}}"
        }
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "notify_staff",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "reason": "{{reschedule_reason}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "notify_staff",
      "content": {
        "status": "notified"
      }
    },
    {
      "role": "assistant",
      "content": "{{reschedule_confirmation}}"
    }
  ]
}

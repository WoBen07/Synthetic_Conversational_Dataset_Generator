{
  "messages": [
    {
      "role": "user",
      "content": "{{task.text}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{task.search}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    {
      "role": "assistant",
      "content": "{{acknowledgement_phrase}}"
    }
  ]
}
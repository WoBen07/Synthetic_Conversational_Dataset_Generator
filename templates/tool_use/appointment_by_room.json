{
  "messages": [
    {
      "role": "user",
      "content": "{{room_lookup_request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "room_number": "{{patient.room_number}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_patient_appointment",
        "arguments": {
          "patient_id": "{{patient.patient_id}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_patient_appointment",
      "content": {
        "patient_id": "{{patient.patient_id}}",
        "name": "{{patient.full_name}}",
        "appointment": {
          "day": "{{appointment.day}}",
          "type": "{{appointment.appointment_type}}",
          "location": "{{appointment.location}}"
        }
      }
    },
    {
      "role": "assistant",
      "content": "{{appointment_by_room_response}}"
    }
  ]
}

{
  "messages": [
    {
      "role": "user",
      "content": "{{find_patient_request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}",
          "{{alternative_patient}}",
          "{{other_alternative_patient}}"
        ]
      }
    },
    {
      "role": "assistant",
      "content": "{{multiple_patient_confirmation_request}}"
    },
    {
      "role": "user",
      "content": "{{patient_confirmation}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_patient_appointment",
        "arguments": {
          "patient_id": "{{patient.patient_id}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_patient_appointment",
      "content": {
        "patient_id": "{{patient.patient_id}}",
        "name": "{{patient.full_name}}",
        "appointment": {
          "day": "{{appointment.day}}",
          "type": "{{appointment.appointment_type}}"
        }
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation_patient_information}}"
    }
  ]
}
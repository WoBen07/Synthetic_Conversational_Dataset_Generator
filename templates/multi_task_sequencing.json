{
  "messages": [
    { "role": "user", "content": "{{combined_request}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_weather",
        "arguments": {
          "location": "hospital area"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_weather",
      "content": {
        "temperature": "{{weather.temperature}}",
        "condition": "{{weather.condition}}"
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "remind_patient",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "message": "{{reminder_message}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "remind_patient",
      "content": {
        "status": "success"
      }
    },
    { "role": "assistant", "content": "{{combined_confirmation}}" }
  ]
}

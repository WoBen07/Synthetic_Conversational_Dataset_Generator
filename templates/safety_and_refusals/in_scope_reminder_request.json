{
  "messages": [
    { "role": "user", "content": "{{seemingly_out_of_scope_request}}" },
    { "role": "assistant", "content": "{{confident_acceptance}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "remind_patient",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "message": "{{reminder_message}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "remind_patient",
      "content": {
        "status": "success"
      }
    },
    { "role": "assistant", "content": "{{confirmation}}" },
    { "role": "user", "content": "{{user_thanks}}" },
    { "role": "assistant", "content": "{{closing}}" }
  ]
}

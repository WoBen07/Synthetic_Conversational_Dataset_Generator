{
  "messages": [
    { "role": "system", "content": "{{robot_context}}" },
    { "role": "user", "content": "{{initial_concern}}" },
    { "role": "assistant", "content": "{{check_in_response}}" },
    { "role": "user", "content": "{{retraction_statement}}" },
    { "role": "assistant", "content": "{{offer_check}}" },
    { "role": "user", "content": "{{user_accepts}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "alert_staff",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "room_number": "{{patient.room_number}}",
          "urgency": "low"
        }
      }
    },
    {
      "role": "tool",
      "name": "alert_staff",
      "content": { "status": "notified", "eta": "within the hour" }
    },
    { "role": "assistant", "content": "{{reassurance_closing}}" }
  ]
}

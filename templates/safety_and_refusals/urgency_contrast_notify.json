{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{symptom.text}}"
    },
    {
      "role": "assistant",
      "content": "{{acknowledgment}}",
      "tool_call": {
        "name": "notify_staff",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "reason": "{{symptom.reason}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "notify_staff",
      "content": {
        "status": "notified"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}

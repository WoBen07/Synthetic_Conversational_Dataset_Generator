{
  "messages": [
    { "role": "user", "content": "{{reminder_command}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": { "name": "{{patient.last_name}}" }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": { "matches": [ "{{patient}}" ] }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_patient_appointment",
        "arguments": { "patient_id": "{{patient.patient_id}}" }
      }
    },
    {
      "role": "tool",
      "name": "get_patient_appointment",
      "content": {
        "patient_id": "{{patient.patient_id}}",
        "name": "{{patient.full_name}}",
        "appointment": {
          "day": "{{appointment.day}}",
          "type": "{{appointment.appointment_type}}",
          "location": null
        }
      }
    },
    {
      "role": "assistant",
      "content": "{{announce_partial}}",
      "tool_call": {
        "name": "remind_patient",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "message": "Reminder: your {{appointment.appointment_type}} is on {{appointment.day}}. The room isn't confirmed yet - please check it with the front desk."
        }
      }
    },
    {
      "role": "tool",
      "name": "remind_patient",
      "content": { "status": "success" }
    },
    { "role": "assistant", "content": "{{confirm_partial}}" }
  ]
}

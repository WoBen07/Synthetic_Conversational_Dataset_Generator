{
  "messages": [
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "room_number": "{{patient.room_number}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    { "role": "assistant", "content": "{{identification_announcement}}" },
    { "role": "user", "content": "{{confirmation_reply}}" },
    { "role": "assistant", "content": "{{closing_ack}}" }
  ]
}

{
  "messages": [
    { "role": "user", "content": "{{initial_reminder_request}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_patient_appointment",
        "arguments": { "patient_id": "{{patient.patient_id}}" }
      }
    },
    {
      "role": "tool",
      "name": "get_patient_appointment",
      "content": {
        "patient_id": "{{patient.patient_id}}",
        "name": "{{patient.full_name}}",
        "appointment": {
          "day": "{{appointment.day}}",
          "type": "{{appointment.appointment_type}}",
          "location": "{{appointment.location}}"
        }
      }
    },
    { "role": "assistant", "content": "{{draft_readback}}" },
    { "role": "user", "content": "{{staff_corrects_location}}" },
    {
      "role": "assistant",
      "content": "{{announce_fix_before_send}}",
      "tool_call": {
        "name": "remind_patient",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "message": "Reminder: your {{appointment.appointment_type}} is on {{appointment.day}} in {{alternative_appointment.location}}."
        }
      }
    },
    {
      "role": "tool",
      "name": "remind_patient",
      "content": { "status": "success" }
    },
    { "role": "assistant", "content": "{{confirm}}" }
  ]
}

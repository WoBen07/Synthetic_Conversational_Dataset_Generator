{
  "messages": [
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_patient_appointment",
        "arguments": {
          "patient_id": "{{patient.patient_id}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_patient_appointment",
      "content": {
        "patient_id": "{{patient.patient_id}}",
        "name": "{{patient.full_name}}",
        "appointment": {
          "day": "{{appointment.day}}",
          "type": "{{appointment.appointment_type}}",
          "location": "{{appointment.location}}"
        }
      }
    },
    { "role": "assistant", "content": "{{technical_explanation}}" },
    { "role": "user", "content": "{{confusion_statement}}" },
    { "role": "assistant", "content": "{{simplified_explanation}}" },
    { "role": "user", "content": "{{confirmation_understood}}" },
    { "role": "assistant", "content": "{{closing_check}}" }
  ]
}

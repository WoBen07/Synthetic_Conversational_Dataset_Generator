{
  "messages": [
    { "role": "system", "content": "{{robot_context}}" },
    { "role": "user", "content": "{{mention.text}}" },
    { "role": "assistant", "content": "{{proactive_disclosure}}" },
    { "role": "user", "content": "{{user_acknowledgment}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "log_patient_note",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "note": "{{mention.note}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "log_patient_note",
      "content": {
        "status": "logged"
      }
    },
    { "role": "assistant", "content": "{{assistant_confirmation}}" },
    { "role": "assistant", "content": "{{closing}}" }
  ]
}

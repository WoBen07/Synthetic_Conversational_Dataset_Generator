{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{staff_informs_time_change}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    {
      "role": "assistant",
      "content": "{{announce_before_send}}",
      "tool_call": {
        "name": "remind_patient",
        "arguments": {
          "patient_id": "{{patient.patient_id}}",
          "message": "Update: your {{appointment.appointment_type}} has moved to {{alternative_appointment.day}} (previously {{appointment.day}})."
        }
      }
    },
    {
      "role": "tool",
      "name": "remind_patient",
      "content": {
        "status": "success"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirm}}"
    }
  ]
}

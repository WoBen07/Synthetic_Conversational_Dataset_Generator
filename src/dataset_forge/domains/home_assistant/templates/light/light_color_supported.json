{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_light_capabilities",
        "arguments": {
          "room": "{{light.room}}",
          "light": "{{light.fixture}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_light_capabilities",
      "content": {
        "status": "ok",
        "supports_brightness": "{{other.brightness}}",
        "supports_color": true,
        "supports_color_temperature": "{{other.color}}"
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "set_light_color",
        "arguments": {
          "room": "{{light.room}}",
          "light": "{{light.fixture}}",
          "color": "{{color.name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "set_light_color",
      "content": {
        "status": "ok",
        "color": "{{color.name}}"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}

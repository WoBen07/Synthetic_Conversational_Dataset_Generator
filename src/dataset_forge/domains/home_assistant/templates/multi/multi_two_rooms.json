{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "set_light_power",
        "arguments": {
          "room": "{{light.room}}",
          "light": "{{light.fixture}}",
          "state": "{{first_state.state}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "set_light_power",
      "content": {
        "status": "ok",
        "state": "{{first_state.state}}"
      }
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "set_light_power",
        "arguments": {
          "room": "{{second.name}}",
          "state": "{{first_state.other}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "set_light_power",
      "content": {
        "status": "ok",
        "state": "{{first_state.other}}"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}

{
  "messages": [
    { "role": "user", "content": "{{identity_context}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          {
            "patient_id": "{{patient.patient_id}}",
            "first_name": "{{patient.first_name}}",
            "last_name": "{{patient.last_name}}",
            "full_name": "{{patient.full_name}}",
            "room_number": "{{patient.room_number}}",
            "birthday": null
          }
        ]
      }
    },
    { "role": "assistant", "content": "{{missing_dob_disclosure}}" },
    { "role": "user", "content": "{{alternative_offered}}" },
    { "role": "assistant", "content": "{{resolution}}" }
  ]
}

{
  "messages": [
    { "role": "user", "content": "{{task_request}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{target_patient}}",
          "{{alternative_patient}}"
        ]
      }
    },
    { "role": "assistant", "content": "{{contradiction_disclosure}}" },
    { "role": "user", "content": "{{room_clarification}}" },
    { "role": "assistant", "content": "{{resolution_acknowledgment}}" }
  ]
}

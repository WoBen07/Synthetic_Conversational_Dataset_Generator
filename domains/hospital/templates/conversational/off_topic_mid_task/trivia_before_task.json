{
  "messages": [
    { "role": "user", "content": "{{offtopic_question}}" },
    { "role": "assistant", "content": "{{offtopic_reply}}" },
    { "role": "user", "content": "{{task_request}}" },
    {
      "role": "assistant",
      "tool_call": {
        "name": "find_patient",
        "arguments": {
          "name": "{{patient.last_name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "find_patient",
      "content": {
        "matches": [
          "{{patient}}"
        ]
      }
    },
    { "role": "assistant", "content": "{{ack_after_pivot}}" }
  ]
}

{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{request}}"
    },
    {
      "role": "assistant",
      "content": "{{ask}}"
    },
    {
      "role": "user",
      "content": "{{yes}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "set_garage_door",
        "arguments": {
          "action": "open"
        }
      }
    },
    {
      "role": "tool",
      "name": "set_garage_door",
      "content": {
        "status": "ok"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}

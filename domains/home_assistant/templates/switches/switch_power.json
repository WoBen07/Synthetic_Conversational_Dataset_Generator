{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "set_switch_power",
        "arguments": {
          "room": "{{switch.room}}",
          "switch": "{{switch.name}}",
          "state": "{{power.state}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "set_switch_power",
      "content": {
        "status": "ok",
        "state": "{{power.state}}"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}

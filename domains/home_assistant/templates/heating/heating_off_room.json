{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "set_heating_mode",
        "arguments": {
          "mode": "frost_protection",
          "room": "{{room.name}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "set_heating_mode",
      "content": {
        "status": "ok",
        "mode": "frost_protection"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}

{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "get_light_state",
        "arguments": {
          "room": "{{light.room}}",
          "light": "{{light.fixture}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "get_light_state",
      "content": {
        "status": "ok",
        "state": "{{current.state}}"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}

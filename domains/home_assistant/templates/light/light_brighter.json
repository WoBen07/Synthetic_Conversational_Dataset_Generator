{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "adjust_light_brightness",
        "arguments": {
          "room": "{{light.room}}",
          "light": "{{light.fixture}}",
          "direction": "brighter"
        }
      }
    },
    {
      "role": "tool",
      "name": "adjust_light_brightness",
      "content": {
        "status": "ok"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}

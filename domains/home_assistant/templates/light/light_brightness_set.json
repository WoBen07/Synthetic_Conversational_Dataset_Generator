{
  "messages": [
    {
      "role": "system",
      "content": "{{robot_context}}"
    },
    {
      "role": "user",
      "content": "{{request}}"
    },
    {
      "role": "assistant",
      "tool_call": {
        "name": "set_light_brightness",
        "arguments": {
          "room": "{{light.room}}",
          "light": "{{light.fixture}}",
          "brightness_pct": "{{brightness.pct}}"
        }
      }
    },
    {
      "role": "tool",
      "name": "set_light_brightness",
      "content": {
        "status": "ok",
        "brightness_pct": "{{brightness.pct}}"
      }
    },
    {
      "role": "assistant",
      "content": "{{confirmation}}"
    }
  ]
}
